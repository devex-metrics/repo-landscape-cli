{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devex-metrics/repo-landscape-cli/blob/main/schema/config-v1.schema.json",
  "title": "Repository landscape scan config v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repositories"],
  "properties": {
    "schema_version": { "const": 1 },
    "repositories": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repositoryName" }
    },
    "stale_after_days": { "type": "integer", "minimum": 1, "default": 90 },
    "discovery": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["organization", "reviewed_repositories"],
        "properties": {
          "organization": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
          "reviewed_repositories": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/repositoryName" }
          }
        }
      }
    }
  },
  "anyOf": [
    { "properties": { "repositories": { "type": "array", "minItems": 1 } } },
    { "required": ["discovery"], "properties": { "discovery": { "type": "array", "minItems": 1 } } }
  ],
  "$defs": {
    "repositoryName": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" }
  }
}
